!cuda-tutorial/*/*.h
!cuda-tutorial/*/*.md
!cuda-tutorial/*/*.sbatch
*.o

# Slurm output
*.out

# Python
__pycache__/
*.pyc

# Environments
.env
.venv
env/
venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
